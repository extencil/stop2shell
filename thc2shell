        ;;
    esac

    case "$_s2s_arg" in
      *'/root/.ssh'*)
        printf '%s\n' 'id_rsa  id_rsa.pub  known_hosts  authorized_keys  authorized_hackers'
        ;;
      *'/root'*|*' ~'*)
        printf '%s\n' 'flag.txt  notes.txt  .ssh  .bash_history  definitely_not_a_honeypot'
        ;;
      *'/home'*)
        printf '%s\n' 'you  linus  teso'
        ;;
