      *'/root/.ssh/id_rsa'*)
        printf '%s\n' '-----BEGIN NOT A REAL KEY-----'
        printf '%s\n' 'c3RvcDJzaGVsbCBpcyBhIHByYW5r'
        printf '%s\n' '-----END NOT A REAL KEY-----'
        ;;
      *'/root/.ssh/'*)
        printf 'cat: %s: Is a directory\n' "${_s2s_arg# }"
        ;;
      *'definitely_not_a_honeypot'*)
        printf '%s\n' 'nice try.'
        ;;
      *'/etc/passwd'*)
        printf '%s\n' 'root:x:0:0:root:/root:/bin/2shell'
        printf '%s\n' 'daemon:x:1:1:daemon:/usr/sbin:/usr/sbin/nologin'
        printf '%s\n' 'you:x:1000:1000:Definitely Not Root:/home/you:/bin/bash'
        ;;
      *'/etc/shadow'*)
        printf '%s\n' 'root:$2shell$04$notarealhash$AprilFools:19000:0:99999:7:::'
        printf '%s\n' 'daemon:*:19000:0:99999:7:::'
        printf '%s\n' '# decorative hashes. no credentials here.'
        ;;
      *'/etc/os-release'*)
        printf '%s\n' 'PRETTY_NAME="Stop2Shell Linux 1.0 (Prank)"'
        printf '%s\n' 'NAME="Stop2Shell"'
        printf '%s\n' 'VERSION_ID="2shell"'
        printf '%s\n' 'ID=stop2shell'
        printf '%s\n' 'HOME_URL="https://example.invalid/stop2shell"'
        ;;
      *'.bash_history'*)
        printf '%s\n' 'ls'
        printf '%s\n' 'id'
        printf '%s\n' 'sudo -i'
        printf '%s\n' 'rm -rf / --no-preserve-root'
        printf '%s\n' 'echo "totally root"'
        printf '%s\n' 'history -c'
        printf '%s\n' 'exit'
        ;;
      *'notes.txt'*)
        printf '%s\n' '- it is a prank'
        printf '%s\n' '- there is no exploit'
        printf '%s\n' '- the root is not real'
        printf '%s\n' '- stop naming things 2shell'
        printf '%s\n' '- seriously'
        ;;
      *)
        printf 'cat: %s: No such file or directory\n' "${_s2s_arg# }"
        ;;
    esac
  }

  # ---------------------------------------------------------------------------
  # setup
  # ---------------------------------------------------------------------------
  trap 's2s_cleanup' EXIT
  trap 's2s_reveal int; exit 130' INT
  trap 's2s_cleanup; exit 143' TERM

  if [ "$S2S_TITLE" = 1 ]; then
    printf '\033]0;root@%s: ~\007' "$S2S_HOST"
    S2S_TITLE_SET=1
  fi

  printf '\n'
  printf '%s\n' "  ${S2S_B}${S2S_R}${S2S_NAME}${S2S_RESET} ${S2S_DIM}·${S2S_RESET} ${S2S_CVE} ${S2S_DIM}·${S2S_RESET} CVSS 9.8"
  printf '%s\n' "  ${S2S_DIM}the first *2shell that does not exist${S2S_RESET}"
  printf '\n'
  printf '%s\n' "  ${S2S_DIM}[*] target   : ${S2S_KERNEL}${S2S_RESET}"
  printf '%s\n' "  ${S2S_DIM}[*] scope    : simulated · 0 files · 0 commands · 0 network${S2S_RESET}"
  printf '\n'

  printf '  %s[*]%s scanning kernel offsets ' "$S2S_C" "$S2S_RESET"
  s2s_dots 5
  printf ' %s0x7350%s\n' "$S2S_Y" "$S2S_RESET"

  s2s_step 'KASLR'                  'disabled (emotionally)'
  s2s_step 'SMEP / SMAP'            'optional, like most things'
  s2s_step 'stack canary'           'a canary, not a guard dog'
  s2s_step 'common sense'           'not found'
  s2s_step 'heap grooming'          '0x2shel1'
  s2s_step 'naming convention'      'corrupted'
  s2s_step 'return address'         '0xdeadbeef'
  s2s_step 'root shell'             'spawning...'

  printf '\n'
  printf '  %s[!]%s uid=0(root) gid=0(root) groups=0(root),1000(%s)\n' "$S2S_R" "$S2S_RESET" "$S2S_USER"
  printf '\n'
  printf '%s\n' '  Last login: Thu Apr  1 04:01:00 2026 from 127.0.0.1'
  printf '%s\n' '  Hint: `help` lists commands. `stop2shell` stops 2shell.'
  printf '\n'

  # ---------------------------------------------------------------------------
  # fake shell
  # ---------------------------------------------------------------------------
  while :; do
    printf '%s' "${S2S_B}${S2S_R}root@${S2S_HOST}${S2S_RESET}:${S2S_B}${S2S_C}$(s2s_prompt_path)${S2S_RESET}${S2S_R}#${S2S_RESET} "

    if [ "$S2S_TIMER" -gt 0 ] && { [ -n "${BASH_VERSION:-}" ] || [ -n "${ZSH_VERSION:-}" ]; }; then
      if ! IFS= read -r -t "$S2S_TIMER" S2S_LINE; then
        s2s_reveal timeout
        break
      fi
    else
      if ! IFS= read -r S2S_LINE; then
        s2s_reveal eof
        break
      fi
    fi

    S2S_LINE=$(s2s_sanitize "$S2S_LINE") || S2S_LINE=''

    # trim leading and trailing whitespace
    S2S_CMD=${S2S_LINE#"${S2S_LINE%%[![:space:]]*}"}
    S2S_CMD=${S2S_CMD%"${S2S_CMD##*[![:space:]]}"}

    # a single trailing semicolon is still a command, not an injection
    S2S_CMD=${S2S_CMD%;}

    if [ -z "$S2S_CMD" ]; then
      continue
    fi

    S2S_COUNT=$((S2S_COUNT + 1))

    case "$S2S_CMD" in
      # -- safety and easter eggs first -------------------------------------
      *':(){'*|*':|:'*)
        S2S_N_INJ=$((S2S_N_INJ + 1))
        printf '%s\n' 'nice try. no forks, no bombs, no shell. this is a case statement.'
        ;;

      # -- control ----------------------------------------------------------
      stop2shell|stop\ 2shell|stop2shell.sh)
        s2s_reveal stop
        break
        ;;

      2shell|cve|advisory|cve-2026-2shell)
        printf '%s\n' \
          '  CVE-2026-73501 -- "stop2shell"' \
          '  severity: 10.0 (obviously)' \
          '  type: naming-convention fatigue' \
          '  affected: every timeline, every conference talk, every LinkedIn post' \
          '  impact: none. this is a prank.' \
          '  exploit: you ran a shell script. that is the whole exploit.' \
          '  remediation: stop naming things 2shell.' \
          '' \
          '  the family, 2026:' \
          '    react2shell   ....... yes' \
          '    php2shell     ....... yes' \
          '    node2shell    ....... allegedly' \
          '    java2shell    ....... still compiling' \
          '    nginx2shell   ....... unfortunately' \
          '    terminal2shell ...... the final boss' \
          '    stop2shell    ....... this one. it does not exist.'
        ;;

      help|h|\?)
        S2S_N_HELP=$((S2S_N_HELP + 1))
        printf '%s\n' \
          '  commands in this simulation:' \
          '    id, whoami, uname, hostname, pwd, cd, ls, cat' \
          '    ps, top, free, df, env, history, date, uptime, neofetch' \
          '    sudo, su, systemctl, apt, docker, git, python, node, php, java' \
          '    echo, clear, flag, cve, 2shell, linus, teso' \
          '' \
          '    stop2shell   end the simulation' \
          '    exit         try it' \
          '    help         this'
        ;;

      exit|logout|quit|bye)
        S2S_N_EXIT=$((S2S_N_EXIT + 1))
        if [ "$S2S_N_EXIT" -eq 1 ]; then
          printf '%s\n' '  nice try. 2shell does not exit.'
          printf '%s\n' "  type ${S2S_B}stop2shell${S2S_RESET} to stop it. or press Ctrl-C."
        else
          s2s_reveal exit
          break
        fi
        ;;

      # -- safety and easter eggs -------------------------------------------
      *'$('*|*'`'*|*';'*|*'&&'*|*'||'*)
        S2S_N_INJ=$((S2S_N_INJ + 1))
        printf '%s\n' 'bash: nice try. no shell, no injection, no problem.'
        printf '%s\n' '      (your input is matched against a case statement, not evaluated.)'
        ;;

      *'|'*)
        S2S_N_PIPE=$((S2S_N_PIPE + 1))
        printf '%s\n' 'bash: pipes are disabled in the simulation. one command at a time.'
        ;;

      '[A'|'[B'|'[C'|'[D'|'OA'|'OB'|'OC'|'OD')
        printf '%s\n' '  (no history in here. the past is a simulation too.)'
        ;;

      # -- dangerous things -------------------------------------------------
      sudo*rm*-rf*)
        S2S_N_SUDO=$((S2S_N_SUDO + 1))
        S2S_N_RM=$((S2S_N_RM + 1))
        printf '%s\n' 'rm: absolutely not. this is a prank, not a tragedy.'
        printf '%s\n' '    (nothing was deleted. nothing will be.)'
        ;;

      rm*-rf*)
        S2S_N_RM=$((S2S_N_RM + 1))
        printf '%s\n' 'rm: absolutely not. this is a prank, not a tragedy.'
        printf '%s\n' '    (nothing was deleted. nothing will be.)'
        ;;

      rm|rm\ *)
        S2S_N_RM=$((S2S_N_RM + 1))
        printf '%s\n' 'rm: operation not permitted -- this prank never touches your filesystem.'
        ;;

      dd\ if=*|dd\ of=*|mkfs*|shred*|wipefs*)
        printf '%s\n' 'refused: /dev/sda is not a toy. nothing was written.'
        ;;

      reboot*|shutdown*|poweroff*|halt*|init\ 0*|init\ 6*)
        printf '%s\n' 'refused: the only thing that needs rebooting is the *2shell naming convention.'
        ;;

      touch\ grass|touch\ ./grass|touch\ /root/grass)
        printf '%s\n' "touch: cannot touch 'grass': it is outside."
        ;;

      touch|touch\ *|mkdir|mkdir\ *|rmdir|rmdir\ *|chmod|chmod\ *|chown|chown\ *|mv|mv\ *|cp|cp\ *|ln|ln\ *|truncate|truncate\ *|tee|tee\ *)
        printf '%s\n' 'refused: this simulation is read-only. nothing was created, moved, or changed.'
        ;;

      # -- privilege jokes --------------------------------------------------
      sudo\ make\ me\ a\ sandwich)
        printf '%s\n' 'okay.'
        ;;

      sudo*)
        S2S_N_SUDO=$((S2S_N_SUDO + 1))
        printf '%s\n' 'sudo: you are already root. there is no password to ask for, and we would not ask.'
        ;;

      su|su\ *)
        printf '%s\n' 'su: you are root. there is nothing to switch to except your responsibilities.'
        ;;

      doas*)
        printf '%s\n' 'doas: not on this system. also: you are root.'
        ;;

      systemctl\ stop\ 2shell*|systemctl\ stop\ stop2shell*)
        printf '%s\n' '  Job for 2shell.service canceled.'
        if [ "$S2S_FAST" = 0 ]; then sleep 0.4; fi
        printf '%s\n' '  you tried the right thing. respect.'
        s2s_reveal systemd
        break
        ;;

      systemctl\ status\ 2shell*|systemctl\ status\ stop2shell*)
