(
  # ---------------------------------------------------------------------------
  # defaults
  # ---------------------------------------------------------------------------
  S2S_VERSION='1.0.0'
  S2S_NAME='stop2shell'
  S2S_CVE='CVE-2026-73501'
  S2S_FAST=0
  S2S_COLOR='auto'
  S2S_TITLE=1
  S2S_TITLE_SET=0
  S2S_TIMER=90
  S2S_HELP=0
  S2S_HOST='localhost'
  S2S_USER="${USER:-human}"
  S2S_PWD='/root'
  S2S_COUNT=0
  S2S_UNKNOWN=0
  S2S_N_SUDO=0
  S2S_N_RM=0
  S2S_N_EXIT=0
  S2S_N_INJ=0
  S2S_N_PIPE=0
  S2S_N_FLAG=0
  S2S_N_HELP=0
  S2S_REVEALED=0
  S2S_CLEANED=0
  S2S_T0=0

  s2s_help() {
    printf '%s\n' \
      "stop2shell ${S2S_VERSION} -- a prank with no root" \
      '' \
      'Usage:' \
      '  ./stop2shell.sh [options]' \
      '  . ./stop2shell.sh [options]' \
      '  curl -fsSL <url> | bash -s -- [options]' \
      '' \
      'Options:' \
      '  --fast        skip the animations' \
      '  --no-color    disable ANSI colors' \
      '  --color       force ANSI colors' \
      '  --no-title    do not touch the terminal title' \
      '  --timer N     reveal after N seconds idle (0 = wait forever, default 90)' \
      '  -h, --help    show this help' \
      '' \
      'It fakes an LPE, gives you a fake root shell, then reveals the prank.' \
      'It never runs your input, touches files, uses the network, or asks for a password.'
  }

  # ---------------------------------------------------------------------------
  # arguments
  # ---------------------------------------------------------------------------
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --fast)       S2S_FAST=1; shift ;;
      --no-color)   S2S_COLOR=0; shift ;;
      --color)      S2S_COLOR=1; shift ;;
      --no-title)   S2S_TITLE=0; shift ;;
      --timer)
        shift
        S2S_TIMER="${1:-90}"
        if [ "$#" -gt 0 ]; then shift; fi
        ;;
      --timer=*)    S2S_TIMER="${1#--timer=}"; shift ;;
      -h|--help)    S2S_HELP=1; shift ;;
      *)            shift ;;
    esac
  done

  if [ "$S2S_HELP" = 1 ]; then
    s2s_help
    exit 0
  fi

  case "$S2S_TIMER" in
    ''|*[!0-9]*) S2S_TIMER=90 ;;
  esac

  # ---------------------------------------------------------------------------
  # colors
  # ---------------------------------------------------------------------------
  if [ "$S2S_COLOR" = 'auto' ]; then
    if [ -t 1 ]; then S2S_COLOR=1; else S2S_COLOR=0; fi
  fi

  if [ "$S2S_COLOR" = 1 ]; then
    S2S_E=$(printf '\033')
    S2S_RESET="${S2S_E}[0m"
    S2S_B="${S2S_E}[1m"
    S2S_DIM="${S2S_E}[2m"
    S2S_R="${S2S_E}[0;31m"
    S2S_G="${S2S_E}[0;32m"
    S2S_Y="${S2S_E}[0;33m"
    S2S_C="${S2S_E}[0;36m"
  else
    S2S_RESET=''
    S2S_B=''
    S2S_DIM=''
    S2S_R=''
    S2S_G=''
    S2S_Y=''
    S2S_C=''
  fi

  # ---------------------------------------------------------------------------
  # terminal
  # ---------------------------------------------------------------------------
  if [ "${STOP2SHELL_NO_TTY:-0}" != 1 ] && [ ! -t 0 ]; then
    if ( : </dev/tty ) 2>/dev/null; then
      exec </dev/tty
    else
      printf '%s\n' "${S2S_NAME}: needs a terminal. run it from an interactive shell." >&2
      exit 1
    fi
  fi

  if command -v hostname >/dev/null 2>&1; then
    S2S_HOST=$(hostname 2>/dev/null) || S2S_HOST='localhost'
  else
    S2S_HOST="${HOSTNAME:-localhost}"
  fi
  S2S_HOST="${S2S_HOST%%.*}"
  if [ -z "$S2S_HOST" ]; then S2S_HOST='localhost'; fi

  S2S_KERNEL=$(uname -a 2>/dev/null) || S2S_KERNEL='Linux (unknown)'
  S2S_T0=$(date +%s 2>/dev/null) || S2S_T0=0
  case "$S2S_T0" in ''|*[!0-9]*) S2S_T0=0 ;; esac

  # ---------------------------------------------------------------------------
  # helpers
  # ---------------------------------------------------------------------------
  s2s_dots() {
    _s2s_i=0
    while [ "$_s2s_i" -lt "$1" ]; do
      printf '.'
      _s2s_i=$((_s2s_i + 1))
      if [ "$S2S_FAST" = 0 ]; then sleep 0.05; fi
    done
  }

  s2s_step() {
    printf '  %s[+]%s %-27s %s\n' "$S2S_G" "$S2S_RESET" "$1" "$2"
    if [ "$S2S_FAST" = 0 ]; then sleep 0.07; fi
  }

  s2s_stat() {
    printf '  %-24s %s\n' "$1" "$2"
  }

  s2s_sanitize() {
    printf '%s' "$1" | tr -d '\000-\010\013\014\016-\037\177' || :
  }

  s2s_prompt_path() {
    case "$S2S_PWD" in
      /root) printf '~' ;;
      *)     printf '%s' "$S2S_PWD" ;;
    esac
  }

  s2s_cleanup() {
    if [ "$S2S_CLEANED" = 0 ]; then
      S2S_CLEANED=1
      if [ -n "$S2S_RESET" ]; then printf '%s' "$S2S_RESET"; fi
      if [ "$S2S_TITLE_SET" = 1 ]; then
        printf '\033]0;\007\033]2;\007'
      fi
    fi
  }

  s2s_reveal() {
    if [ "$S2S_REVEALED" = 1 ]; then return; fi
    S2S_REVEALED=1

    S2S_T1=$(date +%s 2>/dev/null) || S2S_T1=0
    case "$S2S_T1" in ''|*[!0-9]*) S2S_T1=0 ;; esac
    if [ "$S2S_T0" -gt 0 ] && [ "$S2S_T1" -ge "$S2S_T0" ]; then
      S2S_ELAPSED=$((S2S_T1 - S2S_T0))
    else
      S2S_ELAPSED=0
    fi

    printf '\n'
    printf '%s\n' \
      "${S2S_R}  ┏━╸┏━┓╺┳╸┏━╸┳ ┳┏━┓${S2S_RESET}" \
      "${S2S_R}  ┃╺┓┃ ┃ ┃ ┃  ┣━┫┣━┫${S2S_RESET}" \
      "${S2S_R}  ┗━┛┗━┛ ╹ ┗━╸┻ ┻┻ ┻${S2S_RESET}"
    printf '\n'

    case "$1" in
      stop)    printf '%s\n' "  ${S2S_Y}You stopped 2shell.${S2S_RESET} The timeline is safe. For now." ;;
      systemd) printf '%s\n' "  ${S2S_Y}You tried to stop 2shell with systemd.${S2S_RESET} Respect." ;;
      timeout) printf '%s\n' "  ${S2S_Y}Your root session expired.${S2S_RESET} Like the hype." ;;
      int)     printf '%s\n' "  ${S2S_Y}Ctrl-C:${S2S_RESET} the most reliable 0-day." ;;
      eof)     printf '%s\n' "  ${S2S_Y}Ctrl-D:${S2S_RESET} the universal exit." ;;
      exit)    printf '%s\n' "  ${S2S_Y}You tried to exit 2shell.${S2S_RESET} Adorable." ;;
      *)       printf '%s\n' "  ${S2S_Y}And that was the whole exploit.${S2S_RESET}" ;;
    esac
    printf '\n'

    printf '%s\n' \
      '  This was a prank. There was never a CVE, a kernel bug, or a root shell.' \
      '  Every command you typed was matched against a case statement. Nothing ran.' \
      '  No files of yours were read, written, or deleted. No network. No persistence.' \
      '  Your prompt, history, aliases, and shell options are exactly as you left them.'
    printf '\n'

    printf '  %s── prank report ─────────────────────────────%s\n' "$S2S_DIM" "$S2S_RESET"
    s2s_stat 'commands typed' "$S2S_COUNT"
    s2s_stat 'root acquired' '0'
    s2s_stat 'files touched' '0'
    s2s_stat 'commands executed' '0'
    s2s_stat 'sudo attempts' "$S2S_N_SUDO"
    s2s_stat 'rm -rf attempts' "$S2S_N_RM"
    s2s_stat 'injection attempts' "$S2S_N_INJ"
    s2s_stat 'time wasted' "${S2S_ELAPSED}s"
    s2s_stat 'dignity' 'intact'

    S2S_BADGES=''
    if [ "$S2S_N_SUDO" -gt 0 ]; then S2S_BADGES="$S2S_BADGES sudo-enjoyer"; fi
    if [ "$S2S_N_RM" -gt 0 ]; then S2S_BADGES="$S2S_BADGES destroyer-of-worlds-(simulated)"; fi
    if [ "$S2S_N_EXIT" -gt 0 ]; then S2S_BADGES="$S2S_BADGES escape-artist"; fi
    if [ "$S2S_N_INJ" -gt 0 ]; then S2S_BADGES="$S2S_BADGES injection-enthusiast"; fi
    if [ "$S2S_N_PIPE" -gt 0 ]; then S2S_BADGES="$S2S_BADGES pipe-dreamer"; fi
    if [ "$S2S_N_FLAG" -gt 0 ]; then S2S_BADGES="$S2S_BADGES flag-collector"; fi
    if [ "$S2S_N_HELP" -gt 0 ]; then S2S_BADGES="$S2S_BADGES help-seeker"; fi
    if [ -n "$S2S_BADGES" ]; then
      printf '  %-24s%s\n' 'badges' "$S2S_BADGES"
    fi
    printf '\n'

    printf '%s\n' \
      "  The *2shell naming convention has gone far enough." \
      "  ${S2S_B}stop2shell${S2S_RESET}: the first one that does not exist." \
      '' \
      "  share: ${S2S_C}#stop2shell${S2S_RESET}" \
      "  inspired by ${S2S_DIM}7350pipe${S2S_RESET} (THC, 2025)"
    printf '\n'

    printf '  %sP.S. your root shell is still running.%s\n' "$S2S_DIM" "$S2S_RESET"
    if [ "$S2S_FAST" = 0 ]; then sleep 1; fi
    printf '  %s(it is not.)%s\n' "$S2S_DIM" "$S2S_RESET"
    printf '\n'
  }

  # ---------------------------------------------------------------------------
  # fake command handlers
  # ---------------------------------------------------------------------------
  s2s_ls() {
    _s2s_arg=$1
    case "$_s2s_arg" in
      *'-la'*|*'-al'*|*'-l'*|*'-a'*)
